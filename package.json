{
  "name": "survey",
  "version": "0.0.0",
  "private": true,
  "description": "Solana stake-and-slash survey platform",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "anchor:build": "pnpm --filter @survey/anchor anchor:build",
    "anchor:test": "pnpm --filter @survey/anchor anchor:test",
    "db:generate": "pnpm --filter @survey/db prisma:generate",
    "db:migrate": "pnpm --filter @survey/db prisma:migrate",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "turbo": "^2.3.0",
    "typescript": "^5.6.3"
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": [
        "react",
        "react-dom"
      ]
    }
  },
  "dependencies": {
    "bs58": "^6.0.0"
  }
}
