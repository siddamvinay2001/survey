{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalDependencies": [".env", ".env.example"],
  "globalEnv": [
    "NODE_ENV",
    "DATABASE_URL",
    "ANTHROPIC_API_KEY",
    "HELIUS_API_KEY",
    "VALIDATOR_KEYPAIR",
    "JWT_SECRET",
    "NEXT_PUBLIC_RPC_URL",
    "NEXT_PUBLIC_PROGRAM_ID"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "anchor:build": {
      "outputs": ["target/deploy/**", "target/idl/**", "target/types/**"]
    },
    "anchor:test": {
      "dependsOn": ["anchor:build"],
      "outputs": []
    },
    "prisma:generate": {
      "outputs": ["node_modules/.prisma/**", "src/generated/**"]
    },
    "clean": {
      "cache": false
    }
  }
}
