{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "format": {
      "dependsOn": ["^format"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "anchor:build": {
      "dependsOn": ["^anchor:build"],
      "inputs": ["packages/anchor/**"],
      "outputs": ["packages/anchor/target/**"]
    },
    "anchor:test": {
      "dependsOn": ["anchor:build"],
      "cache": false
    },
    "db:generate": {
      "outputs": ["node_modules/.prisma/**", "src/generated/**"]
    },
    "db:migrate": {
      "cache": false
    }
  }
}
