# =============================================================================
# Survey platform — environment variables
# Copy to `.env.local` (apps/web) or `.env` (root for shared scripts).
# Never commit real values. Validator keypair belongs in a secret manager in prod.
# =============================================================================

# ---- Database (Supabase Postgres) ----
# Pooled connection string from Supabase project settings
DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:6543/postgres?pgbouncer=true"
# Direct connection (required by Prisma for migrations)
DIRECT_URL="postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres"

# ---- Anthropic (LLM-based response scoring) ----
ANTHROPIC_API_KEY="sk-ant-..."

# ---- Helius (Solana RPC + webhooks) ----
HELIUS_API_KEY=""
HELIUS_WEBHOOK_SECRET=""

# ---- Solana ----
# Public-safe: shipped to the browser
NEXT_PUBLIC_RPC_URL="https://api.devnet.solana.com"
NEXT_PUBLIC_PROGRAM_ID="REPLACE_WITH_DEPLOYED_PROGRAM_ID"

# Server-only: base58-encoded secret key of the validator signer
# In production: pull from AWS Secrets Manager / Doppler / Vault, NOT this file.
VALIDATOR_KEYPAIR=""

# ---- Auth ----
# Random 32+ byte secret for JWT signing (jose HS256)
JWT_SECRET=""

# ---- App ----
NEXT_PUBLIC_APP_URL="http://localhost:3000"
